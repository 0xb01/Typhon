<ui:FluentWindow x:Class="Typhon.Lite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Typhon.Lite.ViewModels"
        mc:Ignorable="d"
        Title="Typhon: Lite"
        Height="310" Width="390"
        MinHeight="310" MinWidth="390"
        MaxHeight="310" MaxWidth="390"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Acrylic"
        Background="Transparent"
        ExtendsContentIntoTitleBar="True"
        Topmost="{Binding IsTopmost}"
        ResizeMode="CanMinimize"
        MouseDown="Window_MouseDown"
        Icon="typhon_ico.png">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- FROSTED GLASS BACKGROUND SHELL -->
    <Border Background="#660A0E17"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <ui:TitleBar Grid.Row="0"
                         x:Name="TitleBar"
                         Title="Typhon: Lite"
                         ShowMaximize="False"
                         ShowMinimize="True"
                         ShowClose="True"
                         Height="34"
                         Background="Transparent"
                         Foreground="#F8FAFC">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="typhon_ico.png" Width="18" Height="18" Margin="0,0,-10,0"/>
                </ui:TitleBar.Icon>
                <ui:TitleBar.TrailingContent>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- About (Info) Button -->
                        <ui:Button Appearance="Transparent"
                                   Padding="6,3"
                                   Margin="0,0,4,0"
                                   Command="{Binding ToggleAboutCommand}"
                                   ToolTip="About">
                            <ui:SymbolIcon Symbol="Info20"
                                           FontSize="14"
                                           Foreground="#94A3B8" />
                        </ui:Button>

                        <!-- Pin (Always on top) Button -->
                        <ui:Button Appearance="Transparent"
                                   Padding="6,3"
                                   Margin="0,0,6,0"
                                   Command="{Binding ToggleTopmostCommand}"
                                   ToolTip="Toggle Always On Top">
                            <ui:SymbolIcon Symbol="Pin20"
                                           FontSize="14"
                                           Foreground="{Binding PinIconColor}" />
                        </ui:Button>
                    </StackPanel>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>

            <!-- MAIN CONTAINER -->
            <Grid Grid.Row="1" Margin="14,2,14,14">
                <!-- BACKGROUND: BLURRED SILHOUETTE GRAPH -->
                <Grid ClipToBounds="True" IsHitTestVisible="False">
                    <Viewbox Stretch="Fill" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Canvas Width="400" Height="200">
                            <!-- Primary Silhouette Glow Fill (Subtle Blur) -->
                            <Path Data="{Binding SilhouetteGeometry}"
                                  Opacity="0.40">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00E5FF" Offset="0.0" />
                                        <GradientStop Color="#00C853" Offset="0.45" />
                                        <GradientStop Color="#00000000" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                                <Path.Effect>
                                    <BlurEffect Radius="8" RenderingBias="Performance" />
                                </Path.Effect>
                            </Path>

                            <!-- Secondary Silhouette Inner Glow (Light Blur) -->
                            <Path Data="{Binding SilhouetteGeometry}"
                                  Opacity="0.25">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#38BDF8" Offset="0.0" />
                                        <GradientStop Color="#059669" Offset="0.6" />
                                        <GradientStop Color="#00000000" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                                <Path.Effect>
                                    <BlurEffect Radius="4" RenderingBias="Performance" />
                                </Path.Effect>
                            </Path>

                            <!-- Silhouette Top Boundary Stroke -->
                            <Path Data="{Binding SilhouetteStrokeGeometry}"
                                  Stroke="#8038BDF8"
                                  StrokeThickness="1.5"
                                  Opacity="0.85">
                                <Path.Effect>
                                    <BlurEffect Radius="1" RenderingBias="Performance" />
                                </Path.Effect>
                            </Path>
                        </Canvas>
                    </Viewbox>
                </Grid>

                <!-- FOREGROUND CONTENT: METRICS & CONTROLS -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- TOP ROW: PROCESS COUNT & PERCENTAGE BADGE -->
                    <Grid Grid.Row="0" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Total running processes -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DeveloperBoard20"
                                           FontSize="15"
                                           Margin="0,0,6,0"
                                           Foreground="#818CF8" />
                            <TextBlock Text="{Binding ProcessCount}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="#E2E8F0" />
                            <TextBlock Text=" processes"
                                       FontSize="13"
                                       Foreground="#94A3B8"
                                       Margin="3,0,0,0" />
                        </StackPanel>

                        <!-- Percentage Display -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Gauge20"
                                           FontSize="13"
                                           Foreground="#38BDF8"
                                           Margin="0,0,5,0" />
                            <TextBlock Text="{Binding MemoryPercentageFormatted}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="#F8FAFC" />
                        </StackPanel>
                    </Grid>

                    <!-- STATUS ROW -->
                    <Grid Grid.Row="1" Margin="0,0,0,2">
                        <TextBlock Text="{Binding StatusMessage}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="#34D399"
                                   FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- MIDDLE AREA: HERO RAM USAGE DISPLAY (IN FRONT OF GRAPH) -->
                    <Grid Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UsedMemoryGB, StringFormat={}{0:F1}}"
                                       FontSize="56"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Color="#000000" Opacity="0.6" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text=" GB"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Bottom"
                                       Margin="2,0,6,12"
                                       Foreground="#94A3B8">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.5" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="{Binding TotalMemoryGB, StringFormat={}/ {0:F1} GB}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,12"
                                       Foreground="#64748B">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="#000000" Opacity="0.5" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- BOTTOM CONTROLS: TOGGLES CARD & REDESIGNED FREE MEMORY BUTTON -->
                    <Grid Grid.Row="3" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Redesigned Frosted Toggles Card (Left) -->
                        <Border Grid.Column="0"
                                Background="#1F0A101D"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,6"
                                Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 0: Auto-free (30s) -->
                                <Grid Grid.Row="0" Margin="0,1,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Timer20"
                                                       FontSize="14"
                                                       Foreground="#38BDF8"
                                                       Margin="0,0,6,0" />
                                        <TextBlock Text="Auto 30s"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#E2E8F0"
                                                   VerticalAlignment="Center" />
                                        <Border Margin="6,0,0,0"
                                                CornerRadius="4"
                                                Background="#2610B981"
                                                BorderBrush="#4010B981"
                                                BorderThickness="1"
                                                Padding="5,1"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsAutoFreeEnabled, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding AutoFreeStatusText}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="#34D399" />
                                        </Border>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1"
                                                     IsChecked="{Binding IsAutoFreeEnabled}"
                                                     VerticalAlignment="Center" />
                                </Grid>

                                <!-- Row 1: Run on Startup -->
                                <Grid Grid.Row="1" Margin="0,3,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Rocket20"
                                                       FontSize="14"
                                                       Foreground="#818CF8"
                                                       Margin="0,0,6,0" />
                                        <TextBlock Text="Startup"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="#E2E8F0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1"
                                                     IsChecked="{Binding RunOnStartup}"
                                                     VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Redesigned Radiant Free Memory Button (Right) -->
                        <Button Grid.Column="1"
                                Command="{Binding FreeMemoryCommand}"
                                IsEnabled="{Binding CanFreeMemory}"
                                Width="142"
                                Height="54"
                                Padding="0"
                                VerticalAlignment="Center"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder"
                                                        CornerRadius="10"
                                                        BorderThickness="1"
                                                        BorderBrush="#5038BDF8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#0284C7" Offset="0.0" />
                                                            <GradientStop Color="#059669" Offset="1.0" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="14" ShadowDepth="1" Color="#0284C7" Opacity="0.35" />
                                                    </Border.Effect>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#0EA5E9" Offset="0.0" />
                                                                    <GradientStop Color="#10B981" Offset="1.0" />
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#9038BDF8" />
                                                        <Setter TargetName="btnBorder" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="18" ShadowDepth="1" Color="#38BDF8" Opacity="0.55" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#0369A1" Offset="0.0" />
                                                                    <GradientStop Color="#047857" Offset="1.0" />
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="btnBorder" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#0284C7" Opacity="0.25" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="#221E293B" />
                                                        <Setter TargetName="btnBorder" Property="BorderBrush" Value="#1AFFFFFF" />
                                                        <Setter TargetName="btnBorder" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="0" ShadowDepth="0" Color="#000000" Opacity="0" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Flash24"
                                               FontSize="18"
                                               Margin="0,0,6,0"
                                               Foreground="#FFFFFF" />
                                <TextBlock Text="{Binding FreeButtonText}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="#FFFFFF" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ABOUT FROSTED GLASS OVERLAY -->
            <Grid Grid.RowSpan="2"
                  Visibility="{Binding IsAboutVisible, Converter={StaticResource BoolToVis}}"
                  Background="#18000000">
                <!-- Background Click to Dismiss -->
                <Grid.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseAboutCommand}" />
                </Grid.InputBindings>

                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="14"
                        Background="#500A0E17"
                        BorderBrush="#38FFFFFF"
                        BorderThickness="1"
                        Padding="24,20"
                        Width="280">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.80" Color="#000000" />
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Icon -->
                        <Image Source="typhon_ico.png"
                               Width="38" Height="38"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />

                        <!-- Title -->
                        <TextBlock Text="Typhon: Lite"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Foreground="#F8FAFC"
                                   HorizontalAlignment="Center" />

                        <!-- Version -->
                        <TextBlock Text="{Binding AppVersion}"
                                   FontWeight="Normal"
                                   FontStyle="Italic"
                                   FontSize="11"
                                   Foreground="#94A3B8"
                                   HorizontalAlignment="Center"
                                   Margin="0,2,0,0" />

                        <!-- Author -->
                        <TextBlock Text="by 0xb01"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="#38BDF8"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,16" />

                        <!-- Close Button -->
                        <ui:Button Appearance="Secondary"
                                   Content="Close"
                                   Command="{Binding CloseAboutCommand}"
                                   HorizontalAlignment="Center"
                                   Width="88"
                                   Height="30" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
