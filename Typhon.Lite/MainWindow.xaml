<ui:FluentWindow x:Class="Typhon.Lite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Typhon.Lite.ViewModels"
        mc:Ignorable="d"
        Title="Typhon Lite"
        Height="310" Width="390"
        MinHeight="310" MinWidth="390"
        MaxHeight="310" MaxWidth="390"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Topmost="{Binding IsTopmost}"
        ResizeMode="CanMinimize"
        MouseDown="Window_MouseDown"
        Icon="typhon_ico.png">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <ui:TitleBar Grid.Row="0"
                     x:Name="TitleBar"
                     Title="Typhon: Lite"
                     ShowMaximize="False"
                     ShowMinimize="True"
                     ShowClose="True"
                     Height="34">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="typhon_ico.png" Width="18" Height="18" Margin="0,0,-10,0"/>
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <ui:Button Appearance="Transparent"
                           Padding="6,3"
                           Margin="0,0,6,0"
                           Command="{Binding ToggleTopmostCommand}"
                           ToolTip="Toggle Always On Top">
                    <ui:SymbolIcon Symbol="Pin20"
                                   FontSize="14"
                                   Foreground="{Binding PinIconColor}" />
                </ui:Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- MAIN CONTAINER -->
        <Grid Grid.Row="1" Margin="14,2,14,14">
            <!-- BACKGROUND: BLURRED SILHOUETTE GRAPH -->
            <Grid ClipToBounds="True" IsHitTestVisible="False">
                <Viewbox Stretch="Fill" Height="170" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                    <Canvas Width="400" Height="180">
                        <!-- Primary Silhouette Glow Fill (Wide Blur) -->
                        <Path Data="{Binding SilhouetteGeometry}"
                              Opacity="0.45">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00E5FF" Offset="0.0" />
                                    <GradientStop Color="#00C853" Offset="0.45" />
                                    <GradientStop Color="#00000000" Offset="1.0" />
                                </LinearGradientBrush>
                            </Path.Fill>
                            <Path.Effect>
                                <BlurEffect Radius="26" RenderingBias="Performance" />
                            </Path.Effect>
                        </Path>

                        <!-- Secondary Silhouette Inner Glow (Medium Blur) -->
                        <Path Data="{Binding SilhouetteGeometry}"
                              Opacity="0.30">
                            <Path.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#38BDF8" Offset="0.0" />
                                    <GradientStop Color="#059669" Offset="0.6" />
                                    <GradientStop Color="#00000000" Offset="1.0" />
                                </LinearGradientBrush>
                            </Path.Fill>
                            <Path.Effect>
                                <BlurEffect Radius="14" RenderingBias="Performance" />
                            </Path.Effect>
                        </Path>

                        <!-- Silhouette Top Boundary Glow Stroke -->
                        <Path Data="{Binding SilhouetteStrokeGeometry}"
                              Stroke="#7038BDF8"
                              StrokeThickness="1.8"
                              Opacity="0.75">
                            <Path.Effect>
                                <BlurEffect Radius="3" RenderingBias="Performance" />
                            </Path.Effect>
                        </Path>
                    </Canvas>
                </Viewbox>
            </Grid>

            <!-- FOREGROUND CONTENT: METRICS & CONTROLS -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- TOP ROW: MEMORY USAGE & PERCENTAGE BADGE -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Current Memory / Total Memory -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding UsedMemoryGB, StringFormat={}{0:F1}}"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#F8FAFC" />
                        <TextBlock Text=" GB"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,6,4"
                                   Foreground="#94A3B8" />
                        <TextBlock Text="{Binding TotalMemoryGB, StringFormat={}/ {0:F1} GB}"
                                   FontSize="14"
                                   FontWeight="Normal"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,5"
                                   Foreground="#64748B" />
                    </StackPanel>

                    <!-- Memory Percentage Badge -->
                    <Border Grid.Column="1"
                            CornerRadius="8"
                            Background="#2200E5FF"
                            BorderBrush="#4400E5FF"
                            BorderThickness="1"
                            Padding="10,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding MemoryPercentageFormatted}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="#38BDF8" />
                    </Border>
                </Grid>

                <!-- PROCESSES & STATUS ROW -->
                <Grid Grid.Row="1" Margin="0,2,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Total running processes -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="DeveloperBoard20"
                                       FontSize="15"
                                       Margin="0,0,6,0"
                                       Foreground="#818CF8" />
                        <TextBlock Text="{Binding ProcessCount}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="#E2E8F0" />
                        <TextBlock Text=" processes"
                                   FontSize="13"
                                   Foreground="#94A3B8"
                                   Margin="3,0,0,0" />
                    </StackPanel>

                    <!-- Status / Result Message -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="#34D399"
                               FontWeight="Medium"
                               TextTrimming="CharacterEllipsis"
                               Margin="8,0,0,0" />
                </Grid>

                <!-- SPACER (Row 2 is *) -->

                <!-- BOTTOM CONTROLS: TOGGLES & MANUAL FREE BUTTON -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Toggles Stack (Left) -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                        <!-- Auto-free Toggle (every 30s) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ToggleSwitch IsChecked="{Binding IsAutoFreeEnabled}"
                                             Content="Auto (30s)"
                                             FontSize="12" />

                            <Border Margin="8,0,0,0"
                                    CornerRadius="6"
                                    Background="#2610B981"
                                    BorderBrush="#4010B981"
                                    BorderThickness="1"
                                    Padding="6,2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsAutoFreeEnabled, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding AutoFreeStatusText}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="#34D399" />
                            </Border>
                        </StackPanel>

                        <!-- Run on Startup Toggle -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                            <ui:ToggleSwitch IsChecked="{Binding RunOnStartup}"
                                             Content="Run on Startup"
                                             FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Manual Free Memory Button (Right) -->
                    <ui:Button Grid.Column="1"
                               Appearance="Primary"
                               Command="{Binding FreeMemoryCommand}"
                               IsEnabled="{Binding CanFreeMemory}"
                               Height="42"
                               Padding="16,0"
                               VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Flash24"
                                           FontSize="16"
                                           Margin="0,0,6,0" />
                            <TextBlock Text="{Binding FreeButtonText}"
                                       FontWeight="SemiBold"
                                       FontSize="13" />
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
