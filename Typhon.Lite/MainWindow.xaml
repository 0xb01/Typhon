<ui:FluentWindow x:Class="Typhon.Lite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:Typhon.Lite.ViewModels"
        mc:Ignorable="d"
        Title="Typhon: Lite"
        Height="310" Width="390"
        MinHeight="310" MinWidth="390"
        MaxHeight="310" MaxWidth="390"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Acrylic"
        Background="Transparent"
        ExtendsContentIntoTitleBar="True"
        Topmost="{Binding IsTopmost}"
        ResizeMode="CanMinimize"
        MouseDown="Window_MouseDown"
        Icon="typhon_ico.png">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <!-- FROSTED GLASS BACKGROUND SHELL -->
    <Border Background="#660A0E17"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <ui:TitleBar Grid.Row="0"
                         x:Name="TitleBar"
                         Title="Typhon: Lite"
                         ShowMaximize="False"
                         ShowMinimize="True"
                         ShowClose="True"
                         Height="34"
                         Background="Transparent"
                         Foreground="#F8FAFC">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="typhon_ico.png" Width="18" Height="18" Margin="0,0,-10,0"/>
                </ui:TitleBar.Icon>
                <ui:TitleBar.TrailingContent>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- About (Info) Button -->
                        <ui:Button Appearance="Transparent"
                                   Padding="6,3"
                                   Margin="0,0,4,0"
                                   Command="{Binding ToggleAboutCommand}"
                                   ToolTip="About">
                            <ui:SymbolIcon Symbol="Info20"
                                           FontSize="14"
                                           Foreground="#94A3B8" />
                        </ui:Button>

                        <!-- Pin (Always on top) Button -->
                        <ui:Button Appearance="Transparent"
                                   Padding="6,3"
                                   Margin="0,0,6,0"
                                   Command="{Binding ToggleTopmostCommand}"
                                   ToolTip="Toggle Always On Top">
                            <ui:SymbolIcon Symbol="Pin20"
                                           FontSize="14"
                                           Foreground="{Binding PinIconColor}" />
                        </ui:Button>
                    </StackPanel>
                </ui:TitleBar.TrailingContent>
            </ui:TitleBar>

            <!-- MAIN CONTAINER -->
            <Grid Grid.Row="1" Margin="14,2,14,14">
                <!-- BACKGROUND: BLURRED SILHOUETTE GRAPH -->
                <Grid ClipToBounds="True" IsHitTestVisible="False">
                    <Viewbox Stretch="Fill" Height="170" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                        <Canvas Width="400" Height="180">
                            <!-- Primary Silhouette Glow Fill (Subtle Blur) -->
                            <Path Data="{Binding SilhouetteGeometry}"
                                  Opacity="0.40">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00E5FF" Offset="0.0" />
                                        <GradientStop Color="#00C853" Offset="0.45" />
                                        <GradientStop Color="#00000000" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                                <Path.Effect>
                                    <BlurEffect Radius="8" RenderingBias="Performance" />
                                </Path.Effect>
                            </Path>

                            <!-- Secondary Silhouette Inner Glow (Light Blur) -->
                            <Path Data="{Binding SilhouetteGeometry}"
                                  Opacity="0.25">
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#38BDF8" Offset="0.0" />
                                        <GradientStop Color="#059669" Offset="0.6" />
                                        <GradientStop Color="#00000000" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Path.Fill>
                                <Path.Effect>
                                    <BlurEffect Radius="4" RenderingBias="Performance" />
                                </Path.Effect>
                            </Path>

                            <!-- Silhouette Top Boundary Stroke -->
                            <Path Data="{Binding SilhouetteStrokeGeometry}"
                                  Stroke="#8038BDF8"
                                  StrokeThickness="1.5"
                                  Opacity="0.85">
                                <Path.Effect>
                                    <BlurEffect Radius="1" RenderingBias="Performance" />
                                </Path.Effect>
                            </Path>
                        </Canvas>
                    </Viewbox>
                </Grid>

                <!-- FOREGROUND CONTENT: METRICS & CONTROLS -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- TOP ROW: MEMORY USAGE & PERCENTAGE BADGE -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Current Memory / Total Memory -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding UsedMemoryGB, StringFormat={}{0:F1}}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#F8FAFC" />
                            <TextBlock Text=" GB"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,6,4"
                                       Foreground="#94A3B8" />
                            <TextBlock Text="{Binding TotalMemoryGB, StringFormat={}/ {0:F1} GB}"
                                       FontSize="14"
                                       FontWeight="Normal"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,5"
                                       Foreground="#64748B" />
                        </StackPanel>

                        <!-- Unified Frosted Glass Percentage Pill -->
                        <Border Grid.Column="1"
                                CornerRadius="8"
                                Background="#1AFFFFFF"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1"
                                Padding="9,4"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Gauge20"
                                               FontSize="13"
                                               Foreground="#38BDF8"
                                               Margin="0,0,5,0" />
                                <TextBlock Text="{Binding MemoryPercentageFormatted}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="#F8FAFC" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- PROCESSES & STATUS ROW -->
                    <Grid Grid.Row="1" Margin="0,2,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Total running processes -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="DeveloperBoard20"
                                           FontSize="15"
                                           Margin="0,0,6,0"
                                           Foreground="#818CF8" />
                            <TextBlock Text="{Binding ProcessCount}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="#E2E8F0" />
                            <TextBlock Text=" processes"
                                       FontSize="13"
                                       Foreground="#94A3B8"
                                       Margin="3,0,0,0" />
                        </StackPanel>

                        <!-- Status / Result Message -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding StatusMessage}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="#34D399"
                                   FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="8,0,0,0" />
                    </Grid>

                    <!-- SPACER (Row 2 is *) -->

                    <!-- BOTTOM CONTROLS: TOGGLES & MANUAL FREE BUTTON -->
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Toggles Stack (Left) -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <!-- Auto-free Toggle (every 30s) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:ToggleSwitch IsChecked="{Binding IsAutoFreeEnabled}"
                                                 Content="Auto (30s)"
                                                 FontSize="12" />

                                <Border Margin="8,0,0,0"
                                        CornerRadius="6"
                                        Background="#2610B981"
                                        BorderBrush="#4010B981"
                                        BorderThickness="1"
                                        Padding="6,2"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsAutoFreeEnabled, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding AutoFreeStatusText}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#34D399" />
                                </Border>
                            </StackPanel>

                            <!-- Run on Startup Toggle -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                                <ui:ToggleSwitch IsChecked="{Binding RunOnStartup}"
                                                 Content="Run on Startup"
                                                 FontSize="12" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Manual Free Memory Button (Right) -->
                        <ui:Button Grid.Column="1"
                                   Appearance="Primary"
                                   Command="{Binding FreeMemoryCommand}"
                                   IsEnabled="{Binding CanFreeMemory}"
                                   Height="42"
                                   Padding="16,0"
                                   VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Flash24"
                                               FontSize="16"
                                               Margin="0,0,6,0" />
                                <TextBlock Text="{Binding FreeButtonText}"
                                           FontWeight="SemiBold"
                                           FontSize="13" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ABOUT FROSTED GLASS OVERLAY -->
            <Grid Grid.RowSpan="2"
                  Visibility="{Binding IsAboutVisible, Converter={StaticResource BoolToVis}}"
                  Background="#18000000">
                <!-- Background Click to Dismiss -->
                <Grid.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseAboutCommand}" />
                </Grid.InputBindings>

                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="14"
                        Background="#500A0E17"
                        BorderBrush="#38FFFFFF"
                        BorderThickness="1"
                        Padding="24,20"
                        Width="280">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.55" Color="#000000" />
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Icon -->
                        <Image Source="typhon_ico.png"
                               Width="38" Height="38"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10" />

                        <!-- Title -->
                        <TextBlock Text="Typhon: Lite"
                                   FontWeight="Bold"
                                   FontSize="18"
                                   Foreground="#F8FAFC"
                                   HorizontalAlignment="Center" />

                        <!-- Author -->
                        <TextBlock Text="developed by 0xb1"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="#38BDF8"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,16" />

                        <!-- Close Button -->
                        <ui:Button Appearance="Secondary"
                                   Content="Close"
                                   Command="{Binding CloseAboutCommand}"
                                   HorizontalAlignment="Center"
                                   Width="88"
                                   Height="30" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
